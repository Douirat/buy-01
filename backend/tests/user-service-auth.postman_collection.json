{
  "info": {
    "name": "user-service - Auth Endpoints",
    "description": "Register and Login smoke tests for buy-01 user-service.\n\nNOTE: UserController is currently mapped with @RequestMapping(\"/api/api/\"), so register lives at /api/api/register instead of /api/register. Update {{basePath}} once that's fixed.\n\nBoth endpoints use @ModelAttribute, so requests are sent as x-www-form-urlencoded, not JSON.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "host", "value": "http://localhost:8081" },
    { "key": "basePath", "value": "/api/api" },
    { "key": "authPath", "value": "/api/auth" },
    { "key": "testEmail", "value": "" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "item": [
        {
          "name": "Register - valid user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('testEmail', 'testuser+' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has user data', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "Test User" },
                { "key": "email", "value": "{{testEmail}}" },
                { "key": "password", "value": "Password123!" }
              ]
            },
            "url": {
              "raw": "{{host}}{{basePath}}/register",
              "host": ["{{host}}"],
              "path": ["api", "api", "register"]
            }
          }
        },
        {
          "name": "Register - duplicate email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 (adjust to match your handler)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "Test User" },
                { "key": "email", "value": "{{testEmail}}" },
                { "key": "password", "value": "Password123!" }
              ]
            },
            "url": {
              "raw": "{{host}}{{basePath}}/register",
              "host": ["{{host}}"],
              "path": ["api", "api", "register"]
            }
          }
        },
        {
          "name": "Register - invalid fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "" },
                { "key": "email", "value": "not-an-email" },
                { "key": "password", "value": "short" }
              ]
            },
            "url": {
              "raw": "{{host}}{{basePath}}/register",
              "host": ["{{host}}"],
              "path": ["api", "api", "register"]
            }
          }
        },
        {
          "name": "Register - missing body",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [] },
            "url": {
              "raw": "{{host}}{{basePath}}/register",
              "host": ["{{host}}"],
              "path": ["api", "api", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Login",
      "item": [
        {
          "name": "Login - valid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has token', function () {",
                  "    const json = pm.response.json();",
                  "    const data = json.data || json;",
                  "    pm.expect(data).to.have.property('token');",
                  "    pm.collectionVariables.set('token', data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "identifier", "value": "{{testEmail}}" },
                { "key": "password", "value": "Password123!" }
              ]
            },
            "url": {
              "raw": "{{host}}{{authPath}}/login",
              "host": ["{{host}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "identifier", "value": "{{testEmail}}" },
                { "key": "password", "value": "WrongPassword999!" }
              ]
            },
            "url": {
              "raw": "{{host}}{{authPath}}/login",
              "host": ["{{host}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - unknown identifier",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "identifier", "value": "nobody-{{$timestamp}}@example.com" },
                { "key": "password", "value": "Password123!" }
              ]
            },
            "url": {
              "raw": "{{host}}{{authPath}}/login",
              "host": ["{{host}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login - missing body",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [] },
            "url": {
              "raw": "{{host}}{{authPath}}/login",
              "host": ["{{host}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    }
  ]
}
